---
import type { Root, Content, Heading, List, ListItem, Link, Image, Code, InlineCode, Paragraph, Blockquote } from "mdast";
import { toString } from "mdast-util-to-string";
import CodeBlock from "./CodeBlock.astro";
import Callout from "./Callout.astro";
import MarkdownImage from "./MarkdownImage.astro";

export interface Props {
  node: Root | Content;
  data?: any;
}

const { node, data } = Astro.props as Props;
const type = (node as any)?.type ?? "root";

function childrenOf(n: any): any[] {
  return Array.isArray(n?.children) ? n.children : [];
}
---

{type === "root" && (
  <>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </>
)}

{type === "paragraph" && (
  <p>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </p>
)}

{type === "text" && <>{(node as any).value}</>}

{type === "strong" && (
  <strong>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </strong>
)}

{type === "emphasis" && (
  <em>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </em>
)}

{type === "heading" && (() => {
  const heading = node as Heading;
  const level = Math.min(Math.max(heading.depth ?? 1, 1), 6);
  const Tag = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

  // The anchor id comes from LFM's remark-heading-ids (>= 0.4.0), which is the
  // ONLY place it should be computed. Every site used to inline its own
  // slugifier and they disagreed — astro-knots stripped underscores and never
  // trimmed dashes, lossless/site kept them — so the same heading produced
  // different fragment URLs depending on which site rendered it, and nothing
  // deduped collisions. See lfm/context-v/Maintain-Heading-Anchors-and-Share-Links.md
  //
  // The fallback keeps this component renderable against an older LFM rather
  // than emitting headings with no id at all. It is deliberately the LFM
  // algorithm, not the old astro-knots one, so the two agree where they can.
  const fallback = toString(heading)
    .toLowerCase()
    .replace(/\.[a-z0-9]+$/, "")
    .replace(/[^a-z0-9\s\-_]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-{3,}/g, "--")
    .replace(/^-+|-+$/g, "");

  const id = (heading.data as any)?.id ?? fallback;
  const label = (heading.data as any)?.headingText ?? toString(heading);

  return (
    <Tag id={id} class="lfm-heading">
      {childrenOf(node).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
      {/* Anchor works with JS off; the copy affordance upgrades it. */}
      <a class="lfm-heading__anchor" href={`#${id}`} aria-label={`Link to “${label}”`}
         data-share-heading={id}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
          <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
        </svg>
      </a>
    </Tag>
  );
})()}

{type === "list" && (() => {
  const list = node as List;
  const Tag = list.ordered ? "ol" : "ul";
  return (
    <Tag>
      {childrenOf(list).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </Tag>
  );
})()}

{type === "listItem" && (
  <li>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </li>
)}

{type === "link" && (() => {
  const link = node as Link;
  const isExternal = link.url?.startsWith('http');
  return (
    <a
      href={link.url}
      title={link.title ?? undefined}
      {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      {childrenOf(link).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </a>
  );
})()}

{type === "image" && (() => {
  const img = node as Image;
  return <img src={img.url} alt={img.alt ?? ""} title={img.title ?? undefined} loading="lazy" />;
})()}

{type === "code" && (() => {
  const code = node as Code;
  return <CodeBlock language={code.lang ?? undefined} code={code.value} meta={code.meta ?? undefined} />;
})()}

{type === "inlineCode" && (() => {
  const inline = node as InlineCode;
  return <code>{inline.value}</code>;
})()}

{type === "blockquote" && (() => {
  const block = node as Blockquote;
  return (
    <blockquote>
      {childrenOf(block).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </blockquote>
  );
})()}

{type === "thematicBreak" && <hr />}

{type === "table" && (
  <div class="ak-table-wrap">
    <table>
      {childrenOf(node).map((child, idx) => {
        if (idx === 0) {
          return (
            <thead>
              <Astro.self node={child} data={data} />
            </thead>
          );
        }
        return null;
      })}
      <tbody>
        {childrenOf(node).slice(1).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
      </tbody>
    </table>
  </div>
)}

{type === "tableRow" && (
  <tr>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </tr>
)}

{type === "tableCell" && (
  <td>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </td>
)}

{type === "delete" && (
  <del>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </del>
)}

{type === "html" && <Fragment set:html={(node as any).value} />}

{type === "break" && <br />}

{type === "footnoteReference" && (() => {
  const ref: any = node;
  const index = ref.data?.citationIndex ?? ref.identifier;
  const hex = ref.data?.citationHex ?? ref.identifier;
  return (
    <sup class="citation-marker">
      <a href={`#source-${hex}`} title={`Citation ${index}`}>[{index}]</a>
    </sup>
  );
})()}

{type === "footnoteDefinition" && null}

{/* Directive handling: callout + badge */}
{["leafDirective", "containerDirective"].includes(type) && (() => {
  const directive: any = node;
  if (directive.name === "callout") {
    return <Callout node={directive} data={data} />;
  }
  if (directive.name === "image") {
    return <MarkdownImage node={directive} data={data} />;
  }
  // Fallback: render children as-is
  return (
    <div>
      {childrenOf(directive).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </div>
  );
})()}

{type === "textDirective" && (() => {
  const directive: any = node;
  if (directive.name === "badge") {
    return <span class="ak-badge">{childrenOf(directive).map((child) => toString(child))}</span>;
  }
  // Fallback: just render inner text
  return <>{childrenOf(directive).map((child) => toString(child))}</>;
})()}

{/* Fallback for unhandled node types: render children only */}
{![
  "root",
  "paragraph",
  "text",
  "strong",
  "emphasis",
  "heading",
  "list",
  "listItem",
  "link",
  "image",
  "code",
  "inlineCode",
  "blockquote",
  "thematicBreak",
  "table",
  "tableRow",
  "tableCell",
  "delete",
  "html",
  "break",
  "leafDirective",
  "containerDirective",
  "textDirective",
  "footnoteReference",
  "footnoteDefinition",
].includes(type) && (
  <>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </>
)}

<style>
  .ak-badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    background: rgba(59, 130, 246, 0.1);
    color: rgb(96, 165, 250);
  }

  /* Restore list styles stripped by Tailwind preflight */
  ul {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  li {
    margin-bottom: 0.25em;
  }

  /* Nested lists */
  li ul {
    list-style-type: circle;
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  li ol {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  li li ul {
    list-style-type: square;
  }
</style>
