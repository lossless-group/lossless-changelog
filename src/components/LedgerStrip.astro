---
/**
 * The ledger strip — this site's signature element.
 *
 * TWO SERIES, ONE BASELINE, LAYERED. Behind: commits per day, as a filled
 * area. In front: one coloured hairline per day an entry was published,
 * height by how many. Both grow from the same bottom baseline, so the marks
 * sit ON the volume rather than beside it, and you read them together —
 * commit mass with no hairline above it is a day that shipped and never got
 * logged.
 *
 * Commits are DAILY, not weekly. GitHub's stats endpoint only buckets by
 * week, which averages away the thing this record is actually about: a solo
 * operator's focus days. The median active day carries 8 commits and the
 * busiest carries 129. Daily comes from local git via lib/daily.ts.
 *
 * Both scales are LINEAR, clipped at the 95th percentile rather than the
 * maximum. A sqrt scale against the 27-entry outlier used to squeeze 69% of
 * days into a 19–33% band where nothing was distinguishable from anything.
 *
 * Hue means WHEN — the brand ramp mapped onto the corpus's own time axis
 * (lib/era.ts). The gradient IS the legend for the marks; the key below only
 * has to say which series is which.
 *
 * Pure SVG, no client JS, no chart library.
 */
import type { Entry } from "../lib/streams";
import type { Day } from "../lib/daily";
import { spanOf, positionIn, colorFor, type TimeSpan } from "../lib/era";

/**
 * Shared y-scale, passed down for the same reason `span` is: a project strip
 * drawn to its own maximum would make three busy days look like the fleet's
 * record week. Comparability across strips beats per-strip contrast.
 */
export interface LedgerScale {
  entriesPerDay: number;
  commitsPerDay: number;
}

interface Props {
  entries: Entry[];
  span?: TimeSpan;
  /** Commits + lines per day. Replaces the old weekly series. */
  days?: Day[];
  scale?: LedgerScale;
  height?: number;
  compact?: boolean;
  /** Axis furniture + key. The global and per-stream strips, not sparklines. */
  axis?: boolean;
}
const {
  entries, span: spanProp, days = [], scale: scaleProp,
  height = 116, compact = false, axis = false,
} = Astro.props;

const dated = entries.filter((e) => e.date);
const span = spanProp ?? spanOf(dated.map((e) => e.date));

const W = 1000;
const H = height;
const PAD = compact ? 0 : 14;
const BASE = H - PAD;
/**
 * 88% of the available height, not all of it. Values past the p95 clip render
 * at full height, and with no headroom they landed exactly on the top edge —
 * which reads as the chart being cropped rather than the value being capped.
 * The remaining 12% is the air that makes a capped mark legible as capped.
 */
const TALL = (H - PAD * 2) * 0.88;

// Bucket entries by day — a busy day is one taller mark, not a thicker smear.
const buckets = new Map<number, { n: number; date: Date }>();
for (const e of dated) {
  const d = e.date!;
  const key = Math.floor(d.getTime() / 86_400_000);
  const b = buckets.get(key);
  if (b) b.n += 1;
  else buckets.set(key, { n: 1, date: d });
}

const active = days.filter((d) => d.commits > 0);

function p95(values: number[], fallback: number): number {
  if (!values.length) return fallback;
  const s = [...values].sort((a, b) => a - b);
  return Math.max(1, s[Math.min(s.length - 1, Math.floor(s.length * 0.95))]);
}
const scale: LedgerScale = scaleProp ?? {
  entriesPerDay: p95([...buckets.values()].map((b) => b.n), 1),
  commitsPerDay: p95(active.map((d) => d.commits), 1),
};

const xOf = (d: Date) =>
  PAD + Math.min(Math.max(positionIn(span, d), 0), 1) * (W - PAD * 2);

const marks = [...buckets.values()].map((b) => ({
  x: xOf(b.date),
  h: Math.max(2, Math.min(1, b.n / scale.entriesPerDay) * TALL),
  over: b.n > scale.entriesPerDay,
  fill: colorFor(span, b.date),
  label: `${b.date.toISOString().slice(0, 10)} · ${b.n} ${b.n === 1 ? "entry" : "entries"}`,
}));

/**
 * The commit area. Daily data is spiky by nature — most days are zero — so
 * the outline is what carries the shape and the fill only grounds it. Drawn
 * as an explicit polyline down to the baseline between runs, rather than
 * interpolating across gaps, so a quiet fortnight reads as quiet.
 */
const pts = active.map((d) => [xOf(d.date), BASE - Math.min(1, d.commits / scale.commitsPerDay) * TALL] as const);
const areaPath = pts.length > 1
  ? `M ${pts[0][0].toFixed(1)} ${BASE} ` +
    pts.map(([x, y]) => `L ${x.toFixed(1)} ${y.toFixed(1)}`).join(" ") +
    ` L ${pts[pts.length - 1][0].toFixed(1)} ${BASE} Z`
  : "";
const linePath = pts.length > 1
  ? `M ` + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(" L ")
  : "";

/**
 * Hover twin — the SAME scale, with the clip removed.
 *
 * At rest every day above the p95 cap is flattened to the ceiling, which is
 * what makes the chart legible: a median day of 8 keeps real height. But it
 * also hides that the record is a handful of days towering over the rest —
 * seventeen days sit at the cap, from 35 commits to 132.
 *
 * So hover draws the same series without `Math.min`. A 132-commit day runs to
 * 3.8x the frame and straight out of the top. The viewBox clips it, and that
 * is the point: the spike visibly leaves the chart rather than politely
 * touching its ceiling.
 */
/**
 * Capped at 2.2x the frame. The true ratio for the record day is 3.8x, which
 * with overflow open would paint over the headline two sections up — the
 * spike is supposed to escape the chart, not the page. 2.2x still puts every
 * day above the cap visibly outside the box, in proportion to each other.
 */
const AMP_MAX = 2.2;
const ampPts = active.map((d) => {
  const x = xOf(d.date);
  const y = BASE - Math.min(AMP_MAX, d.commits / scale.commitsPerDay) * TALL;
  return [x, y] as const;
});
const ampArea = ampPts.length > 1
  ? `M ${ampPts[0][0].toFixed(1)} ${BASE} ` +
    ampPts.map(([x, y]) => `L ${x.toFixed(1)} ${y.toFixed(1)}`).join(" ") +
    ` L ${ampPts[ampPts.length - 1][0].toFixed(1)} ${BASE} Z`
  : "";
const ampLine = ampPts.length > 1
  ? `M ` + ampPts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(" L ")
  : "";

/**
 * Focus days — more than ten commits. A dot ON the axis, not a column: with
 * the commit series now scaled to its maximum, ordinary days sit low and a
 * column would be invisible at the bottom of the frame. A dot on the baseline
 * marks the day regardless of how tall its spike is, and reads as a rhythm
 * along the axis rather than competing with the spikes above it.
 */
const FOCUS = 10;
const focus = active.filter((d) => d.commits > FOCUS).map((d) => {
  const kinds = [
    d.code && `${d.code.toLocaleString()} code`,
    d.contextv && `${d.contextv.toLocaleString()} context`,
    d.changelog && `${d.changelog.toLocaleString()} changelog`,
    d.content && `${d.content.toLocaleString()} content`,
  ].filter(Boolean).join(" · ");
  return {
    x: xOf(d.date),
    // Dot size carries magnitude so a 132-commit day still reads as bigger
    // than a 12-commit one down on the axis.
    r: 1.1 + Math.min(1, d.commits / scale.commitsPerDay) * 2.2,
    label: `${d.date.toISOString().slice(0, 10)} · ${d.commits} commits · ${kinds || "no line changes"}`,
  };
});

// Month boundaries — rhythm, unlabelled. Eighteen labels would crowd the axis,
// but the grid is what makes a burst read as "three weeks in May".
const months: number[] = [];
if (span.max > span.min && !compact) {
  const d = new Date(span.min);
  d.setUTCDate(1);
  d.setUTCMonth(d.getUTCMonth() + 1);
  while (d.getTime() < span.max) {
    const t = positionIn(span, d);
    if (t > 0 && t < 1) months.push(PAD + t * (W - PAD * 2));
    d.setUTCMonth(d.getUTCMonth() + 1);
  }
}

// Interior year boundaries only — a January before the corpus starts would sit
// off the left edge and imply the record goes back further than it does.
const years: { x: number; label: string }[] = [];
if (span.max > span.min) {
  const y0 = new Date(span.min).getUTCFullYear();
  const y1 = new Date(span.max).getUTCFullYear();
  for (let y = y0 + 1; y <= y1; y++) {
    const t = positionIn(span, new Date(Date.UTC(y, 0, 1)));
    if (t > 0 && t < 1) years.push({ x: PAD + t * (W - PAD * 2), label: String(y) });
  }
}

const monthYear = (ms: number) =>
  new Date(ms).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---

<figure class="ledger" data-compact={compact ? "" : undefined}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img"
       aria-label={`${dated.length} changelog entries and ${active.reduce((n, d) => n + d.commits, 0).toLocaleString()} commits between ${new Date(span.min).toISOString().slice(0, 10)} and ${new Date(span.max).toISOString().slice(0, 10)}`}>

    {months.map((x) => <line x1={x} x2={x} y1={PAD} y2={BASE} class="tick tick--month" />)}
    {!compact && years.map((y) => <line x1={y.x} x2={y.x} y1={0} y2={H} class="tick" />)}

    {areaPath && <path d={areaPath} class="commits" />}
    {ampArea && <path d={ampArea} class="commits commits--amp" />}
    {linePath && <path d={linePath} class="commits-line" />}
    {ampLine && <path d={ampLine} class="commits-line commits-line--amp" />}

    {marks.map((m) => (
      <rect class="mark" x={m.x} y={BASE - m.h} width={1.6} height={m.h} fill={m.fill} rx="0.8"
            data-over={m.over ? "" : undefined}>
        <title>{m.label}</title>
      </rect>
    ))}

    <line x1={PAD} x2={W - PAD} y1={BASE} y2={BASE} class="base" />

    {focus.map((f) => (
      <circle cx={f.x} cy={BASE} r={f.r} class="focus"><title>{f.label}</title></circle>
    ))}
  </svg>

  {!compact && dated.length > 0 && (
    <figcaption>
      <span class="end" style="left:0">{monthYear(span.min)}</span>
      {years.map((y) => <span style={`left:${(y.x / W) * 100}%`}>{y.label}</span>)}
      <span class="end end--right" style="left:100%">{monthYear(span.max)}</span>
    </figcaption>
  )}

  {axis && (
    /* Each item isolates its series — hover to preview, click to hold. Pure
       CSS via :has(); the checkbox is the state and the label is the control,
       so it works on touch and from the keyboard with no client JS. One key
       per page, so the ids cannot collide. */
    <ul class="key">
      <li class="k k--entries">
        <input type="checkbox" id="k-entries" />
        <label for="k-entries">
          <i class="sw sw--entry"></i>a day's changelog entries
          <em>{scale.entriesPerDay}+ = full height</em>
        </label>
      </li>
      <li class="k k--commits">
        <input type="checkbox" id="k-commits" />
        <label for="k-commits">
          <i class="sw sw--commit"></i>a day's commits
          <em>{scale.commitsPerDay}+ = full height</em>
        </label>
      </li>
      <li class="k k--focus">
        <input type="checkbox" id="k-focus" />
        <label for="k-focus">
          <i class="sw sw--focus"></i>focus day
          <em>more than {FOCUS} commits</em>
        </label>
      </li>
      {/* The one encoding the swatches above cannot show: a mark's HUE is its
          date. Nothing else is colour-coded on this chart, and without saying
          so a reader assumes colour means project or category. Shown as the
          ramp itself with the axis's own endpoints under it. */}
      <li class="k k--hue">
        <span class="ramp" aria-hidden="true"></span>
        colour = when
        <em>{monthYear(span.min)} → {monthYear(span.max)}</em>
      </li>
    </ul>
  )}
</figure>

<style>
  .ledger { margin: 0; position: relative; }
  .ledger svg { display: block; width: 100%; height: var(--ledger-height); }

  /* SVG clips to its viewBox by default — `overflow: hidden` is the initial
     value, which is why the amplified peaks were flattening against the top
     of the frame instead of escaping it. Only opened on hover, so the resting
     chart still keeps its own bounds. z-index lifts the escaped spikes above
     the sections they now draw over. */
  .ledger svg:hover { overflow: visible; position: relative; z-index: 5; }
  .ledger[data-compact] svg { height: 26px; }

  .tick { stroke: var(--color-border); stroke-width: 1; }
  .tick--month { stroke: var(--color-border); stroke-width: 0.5; opacity: 0.4; }
  .base { stroke: var(--color-border); stroke-width: 1; }

  /* Ground for the coloured marks, but no longer a whisper — commits per day
     is half of what this chart says and 9% opacity was hiding it. */
  .commits { fill: var(--color-text); opacity: 0.14; }
  /* The outline carries the shape; daily data is spiky and a fill alone reads
     as mush at this width. */
  .commits-line { fill: none; stroke: var(--color-text); stroke-width: 0.9; opacity: 0.5; vector-effect: non-scaling-stroke; }
  .ledger svg:hover .commits { opacity: 0.2; }

  /* On the axis, sized by commit count. Text colour rather than an era hue —
     these are a third reading of the same days and hue means WHEN. */
  .focus { fill: var(--color-text); opacity: 0.5; }
  .focus:hover { opacity: 1; }
  .ledger svg:hover .focus { opacity: 0.8; }

  /* The amplified twin is hidden at rest and swapped in on hover. */
  .commits--amp, .commits-line--amp { opacity: 0; }
  .ledger svg:hover .commits { opacity: 0; }
  .ledger svg:hover .commits-line { opacity: 0; }
  .ledger svg:hover .commits--amp { opacity: 0.2; }
  .ledger svg:hover .commits-line--amp { opacity: 0.75; }
  .commits, .commits-line, .commits--amp, .commits-line--amp { transition: opacity 0.18s ease; }

  rect { transition: opacity 0.15s ease; }
  .ledger svg:hover rect { opacity: 0.5; }
  .ledger rect:hover { opacity: 1; }
  /* A day past the clip is drawn at full height; the dashed edge says "and
     then some" so it is not mistaken for an exact reading. */
  rect[data-over] { stroke: var(--color-bg); stroke-width: 0.8; stroke-dasharray: 2 2; }

  figcaption {
    position: relative; height: 1.1rem; margin-top: 0.4rem;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
  figcaption span { position: absolute; transform: translateX(-50%); }
  figcaption .end { transform: none; color: var(--color-text-muted); }
  figcaption .end--right { transform: translateX(-100%); }

  .key {
    display: flex; flex-wrap: wrap; gap: 0.35rem 1.5rem;
    list-style: none; margin: 0.55rem 0 0; padding: 0;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .key input { position: absolute; opacity: 0; pointer-events: none; }
  .key label {
    display: flex; align-items: center; gap: 0.45rem;
    cursor: pointer; user-select: none;
    padding: 0.1rem 0.3rem; margin: -0.1rem -0.3rem;
    border-radius: var(--radius);
  }
  .key label:hover { color: var(--color-text); }
  .key input:focus-visible + label { outline: 1px solid var(--color-primary); outline-offset: 1px; }
  .key input:checked + label { color: var(--color-text); background: var(--color-surface); }
  .key em { font-style: normal; color: var(--color-text-faint); }

  .sw { width: 11px; height: 11px; border-radius: 2px; flex: none; }
  /* The entry swatch carries the whole era ramp rather than one accent —
     the marks it stands for are every hue on that ramp, so no single
     colour would be honest. */
  .sw--entry { width: 4px; height: 13px; border-radius: 2px; background: var(--gradient-primary); }
  /* Fill plus top rule, matching how the commit series is actually drawn. */
  .sw--commit {
    background: color-mix(in srgb, var(--color-text) 14%, transparent);
    border-top: 1.5px solid color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .sw--focus { background: color-mix(in srgb, var(--color-text) 42%, transparent); }

  /* The era ramp itself, so the legend IS the thing it describes. */
  .k--hue { display: flex; align-items: center; gap: 0.45rem; }
  .ramp {
    width: 52px; height: 8px; border-radius: 4px; flex: none;
    background: var(--gradient-primary);
  }

  /* ── isolation ──
     Hover previews, checked holds. Listed after the base opacities so these
     win without needing !important. */
  .ledger:has(.k--entries label:hover) :is(.commits, .commits-line, .focus),
  .ledger:has(.k--entries input:checked) :is(.commits, .commits-line, .focus) { opacity: 0.05; }
  .ledger:has(.k--entries label:hover) .mark,
  .ledger:has(.k--entries input:checked) .mark { opacity: 1; }

  .ledger:has(.k--commits label:hover) .mark,
  .ledger:has(.k--commits input:checked) .mark { opacity: 0.07; }
  .ledger:has(.k--commits label:hover) :is(.commits, .focus),
  .ledger:has(.k--commits input:checked) :is(.commits, .focus) { opacity: 0.26; }
  .ledger:has(.k--commits label:hover) .commits-line,
  .ledger:has(.k--commits input:checked) .commits-line { opacity: 0.9; }

  .ledger:has(.k--focus label:hover) :is(.mark, .commits, .commits-line),
  .ledger:has(.k--focus input:checked) :is(.mark, .commits, .commits-line) { opacity: 0.07; }
  .ledger:has(.k--focus label:hover) .focus,
  .ledger:has(.k--focus input:checked) .focus { opacity: 0.95; }

  @media (prefers-reduced-motion: reduce) { rect { transition: none; } }
</style>
