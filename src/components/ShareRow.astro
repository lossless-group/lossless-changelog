---
/**
 * Share row — one icon per platform. Clicking one COPIES that platform's URL.
 *
 * Each platform gets its own URL (`/s/<platform>/`) carrying the share card cut
 * for its viewport — see SHARE_TARGETS in lib/seo.ts for why. So the button's
 * job is to put THAT url on the clipboard, not the canonical one: paste it into
 * WhatsApp and WhatsApp crawls the WhatsApp card.
 *
 * Copy rather than a web intent, deliberately. An intent link bounces you
 * through a browser tab and a login you may not have; copying works from any
 * app, on any device, and is the same two keystrokes you were going to use
 * anyway. The toast names the platform so you know which URL you got.
 */
import { SHARE_TARGETS, SITE_NAME } from "../lib/seo";

const origin = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, "");

/** Recognisable brand marks. Five glyphs is not worth a dependency. */
const ICONS: Record<string, string> = {
  whatsapp:
    "M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.27-.2-.57-.35M12.05 21.8a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.89-9.89 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.89-9.89 9.89m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9 0-3.17-1.24-6.15-3.49-8.4",
  imessage:
    "M12 2C6.48 2 2 5.92 2 10.76c0 2.76 1.46 5.22 3.74 6.83-.16 1.36-.72 2.6-1.6 3.6-.16.18-.06.47.18.5 1.94.22 3.9-.5 5.36-1.66.75.16 1.53.25 2.32.25 5.52 0 10-3.92 10-8.76S17.52 2 12 2Z",
  x:
    "M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z",
  slack:
    "M5.04 15.16a2.53 2.53 0 1 1-2.52-2.53h2.52zm1.27 0a2.53 2.53 0 0 1 5.05 0v6.31a2.53 2.53 0 0 1-5.05 0zM8.84 5.04a2.53 2.53 0 1 1 2.52-2.52v2.52zm0 1.27a2.53 2.53 0 0 1 0 5.05H2.52a2.53 2.53 0 1 1 0-5.05zM18.96 8.84a2.53 2.53 0 1 1 2.52 2.52h-2.52zm-1.27 0a2.53 2.53 0 0 1-5.05 0V2.52a2.53 2.53 0 0 1 5.05 0zM15.16 18.96a2.53 2.53 0 1 1-2.53 2.52v-2.52zm0-1.27a2.53 2.53 0 0 1 0-5.05h6.32a2.53 2.53 0 0 1 0 5.05z",
};
const LINK_PATH =
  "M9.5 13.5a4 4 0 0 0 5.66 0l3-3a4 4 0 1 0-5.66-5.66l-1.5 1.5M14.5 10.5a4 4 0 0 0-5.66 0l-3 3a4 4 0 1 0 5.66 5.66l1.5-1.5";

const buttons = Object.entries(SHARE_TARGETS).map(([id, t]) => ({
  id,
  label: t.label,
  path: ICONS[id],
  // The platform-tagged URL — this is what lands on the clipboard.
  url: `${origin}/s/${id}/`,
}));
---
<div class="share" data-share>
  <ul>
    {buttons.map((b) => (
      <li>
        <button class="btn" type="button"
                aria-label={`Copy ${b.label} share link`} title={`Copy ${b.label} link`}
                data-copy={b.url} data-what={b.label}>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="currentColor">
            <path d={b.path} />
          </svg>
        </button>
      </li>
    ))}
    <li>
      <button class="btn" type="button"
              aria-label="Copy plain link" title="Copy plain link"
              data-copy={`${origin}/`} data-what="Plain">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d={LINK_PATH} />
        </svg>
      </button>
    </li>
  </ul>
  <span class="toast" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-share]").forEach((scope) => {
    const toastEl = scope.querySelector<HTMLElement>(".toast");
    let timer: number | undefined;

    const say = (msg: string) => {
      if (!toastEl) return;
      toastEl.textContent = msg;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { toastEl.textContent = ""; }, 2400);
    };

    scope.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.dataset.copy!;
        const what = btn.dataset.what!;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          // clipboard API needs a secure context and can be blocked outright;
          // the textarea route still works when it is.
          const ta = document.createElement("textarea");
          ta.value = url;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch { say("Copy blocked"); ta.remove(); return; }
          ta.remove();
        }
        say(what === "Plain" ? "Link copied" : `${what} link copied`);
        btn.dataset.done = "";
        window.setTimeout(() => { delete btn.dataset.done; }, 1200);
      });
    });
  });
</script>

<style>
  .share { display: flex; align-items: center; gap: 0.55rem; }
  ul { display: flex; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }

  /* Square tap targets — 36px clears the minimum with room, and the row stays
     compact enough to sit beside the eyebrow without competing. */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; padding: 0; cursor: pointer;
    border: 1px solid var(--color-border); border-radius: 50%;
    background: none; color: var(--color-text-faint);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .btn:hover { color: var(--color-text); border-color: var(--color-primary); background: var(--color-surface); }
  .btn:focus-visible { outline: 1px solid var(--color-primary); outline-offset: 2px; }
  /* Momentary confirmation on the button itself, so the feedback is where the
     click was and not only in the toast. */
  .btn[data-done] { color: var(--color-primary); border-color: var(--color-primary); }
  .btn svg { display: block; }

  .toast {
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-primary); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
</style>
