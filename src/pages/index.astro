---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryRow from "../components/EntryRow.astro";
import { getRoots, getAllEntries, totals } from "../lib/streams";

const roots = getRoots();
const recent = getAllEntries().slice(0, 40);
---
<BaseLayout
  title="Lossless Changelog"
  description={`Every ship note across the Lossless tree — ${totals.entries} entries from ${totals.streams} projects, aggregated from their source repositories.`}
>
  <section class="hero measure">
    <h1>Everything we shipped.</h1>
    <p>
      {totals.entries} entries from {totals.streams} projects across the Lossless tree,
      pulled from each repository's own <code>changelog/</code> and merged into one feed.
    </p>
  </section>

  <section class="tree">
    <h2>Projects</h2>
    <div class="roots">
      {roots.map((root) => (
        <div class="root">
          <a class="root-head" href={`/stream/${root.slug}/`}>
            <span class="altitude" data-a={root.altitude}>{root.altitude}</span>
            <strong>{root.title}</strong>
            <span class="n">{root.totalCount}</span>
          </a>
          {root.children.length > 0 && (
            <ul class="kids">
              {root.children.map((child) => (
                <li>
                  <a href={`/stream/${child.slug}/`}>{child.title}</a>
                  <span class="n">{child.ownCount}</span>
                  {child.children.length > 0 && (
                    <ul class="grandkids">
                      {child.children.map((g) => (
                        <li>
                          <a href={`/stream/${g.slug}/`}>{g.title}</a>
                          <span class="n">{g.ownCount}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="feed">
    <h2>Latest</h2>
    {recent.map((entry) => <EntryRow entry={entry} showOrigin />)}
  </section>
</BaseLayout>

<style>
  .hero h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.1; margin: 0 0 0.6rem; letter-spacing: -0.02em; }
  .hero p { color: var(--color-text-muted); margin: 0; }

  h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    margin: 2.75rem 0 0.75rem;
    font-weight: 600;
  }

  .roots { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.85rem; }
  .root {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.85rem 0.95rem;
  }
  .root-head { display: flex; align-items: center; gap: 0.5rem; color: var(--color-text); }
  .root-head:hover { text-decoration: none; color: var(--color-primary); }
  .root-head strong { flex: 1; font-size: 0.95rem; }

  .n { font-size: 0.75rem; color: var(--color-text-faint); font-variant-numeric: tabular-nums; }

  .kids, .grandkids { list-style: none; margin: 0.6rem 0 0; padding: 0; }
  .kids > li { padding: 0.18rem 0; font-size: 0.86rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; }
  .kids > li > a { color: var(--color-text-muted); }
  .grandkids { flex-basis: 100%; margin: 0.15rem 0 0.3rem 0.9rem; border-left: 1px solid var(--color-border); padding-left: 0.6rem; }
  .grandkids li { display: flex; gap: 0.4rem; align-items: baseline; font-size: 0.82rem; padding: 0.1rem 0; }
</style>
