---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryRow from "../components/EntryRow.astro";
import LedgerStrip from "../components/LedgerStrip.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getRoots, getAllEntries, getSubtreeEntries, totals } from "../lib/streams";
import { spanOf, colorFor } from "../lib/era";
import ModelBand from "../components/ModelBand.astro";
import { globalWeeks, globalTotals, ledgerScale } from "../lib/commits";
import { globalLines, proseLines } from "../lib/lines";
import LineBar from "../components/LineBar.astro";
import ShareRow from "../components/ShareRow.astro";
import { augmentationRate } from "../lib/models";
import { GROUPS, groupOf, groupCounts } from "../lib/groups";
import { days as fleetDays, focusTotals, dailyForSubtree } from "../lib/daily";

const roots = getRoots();
const all = getAllEntries();
/**
 * The feed renders deeper than it shows. Thirty entries is the right unfiltered
 * length, but filtering thirty down to one group leaves three or four rows —
 * so each group contributes its most recent 25, and everything past the first
 * thirty overall is marked `data-extra` and revealed only when a filter is on.
 * All of it is in the DOM, so the filter is pure CSS and needs no client JS.
 */
const PER_GROUP = 25;
const seen = new Map<string, number>();
const feed = all.filter((e) => {
  const g = groupOf(e.streamSlug);
  const n = (seen.get(g) ?? 0) + 1;
  seen.set(g, n);
  return n <= PER_GROUP;
});
const SHOWN = 30;
const counts = groupCounts(all);

// The span covers BOTH series, so the commit area is never clipped by the
// changelog's extent — the record starts whenever the first of either began.
const span = spanOf([
  ...all.map((e) => e.date),
  ...globalWeeks.map((w) => new Date(w.w * 1000)),
]);

const aug = augmentationRate(all);

// One scale for every strip on the page, so the rows stay comparable.
const scale = ledgerScale(all.map((e) => e.date), fleetDays.map((d) => d.commits));

const dated = all.filter((e) => e.date);
const first = dated.length ? dated[dated.length - 1].date! : null;
const latest = dated.length ? dated[0].date! : null;

const fmt = (d: Date | null) =>
  d ? d.toLocaleDateString("en-GB", { month: "short", year: "numeric" }) : "";
---
<BaseLayout
  title="Lossless Changelog"
  description={`Every ship note across the Lossless tree — ${totals.entries} entries from ${totals.streams} projects, aggregated from their source repositories.`}
>
  <section class="hero">
    <ShareRow />
    <p class="eyebrow">The Lossless Group · ship log</p>
    <h1>
      Everything<br />
      we <em>shipped</em>.
    </h1>
    <p class="thesis">
      {globalTotals.commits.toLocaleString()} commits across
      {" "}{globalTotals.repos} repositories, {fmt(first)} to {fmt(latest)} —
      {" "}{(globalLines.code / 1_000_000).toFixed(1)}M lines of code and
      {" "}{(proseLines(globalLines) / 1_000_000).toFixed(1)}M of prose,
      mostly one person and a rotating cast of frontier models. The marks are
      the days we wrote it down.
    </p>
  </section>

  <section class="strip">
    <LedgerStrip entries={all} span={span} days={fleetDays} scale={scale} axis />
    <ModelBand entries={all} span={span} />
    <dl class="legend">
      <div><dt>Commits</dt><dd>{globalTotals.commits.toLocaleString()}</dd></div>
      <div><dt>Repos</dt><dd>{globalTotals.repos}</dd></div>
      <div><dt>Entries</dt><dd>{totals.entries}</dd></div>
      <div><dt>Agent-augmented</dt><dd>{aug.pct}%</dd></div>
      {/* The shape of a solo record: not a steady rate, a few days a month
          given over to it entirely. */}
      <div><dt>Focus days</dt><dd>{focusTotals.days}<small>/{focusTotals.activeDays}</small></dd></div>
      <div><dt>Busiest day</dt><dd>{focusTotals.busiest?.commits}<small>commits</small></dd></div>
    </dl>

    <div class="lines">
      <LineBar lines={globalLines} />
      <p class="caveat">
        Lines by kind. Lockfiles and vendored trees are excluded — nobody wrote
        them. Proportions are measured from each repository's own history;
        totals follow GitHub's per-repo accounting, which does not agree with it.
        The marks on the strip's baseline are the {focusTotals.days} days that
        carried more than ten commits — {focusTotals.commitShare}% of everything
        ever committed here landed on one of them.
      </p>
    </div>
  </section>

  <section class="fleet">
    <h2 class="eyebrow">Projects</h2>
    {/* Column header, so the right-hand figure reads as a quantity of
        something rather than an unexplained number. */}
    <div class="ledger-head" aria-hidden="true">
      <span>Project</span>
      <span class="mid">Cadence — entries above, commits below</span>
      <span class="cnt" title="Changelog entries, including sub-projects">Changelog Entries</span>
    </div>
    <ol class="ledger-rows">
      {roots.map((root) => (
        <li class="root">
          <ProjectRow stream={root} entries={getSubtreeEntries(root.slug)}
                      days={dailyForSubtree(root)} span={span} scale={scale} count={root.totalCount} />
          {root.children.length > 0 && (
            <ul class="kids">
              {root.children.map((child) => (
                <li>
                  <ProjectRow stream={child} entries={getSubtreeEntries(child.slug)}
                              days={dailyForSubtree(child)} span={span} scale={scale} count={child.totalCount} kid />
                  {child.children.length > 0 && (
                    <ul class="kids kids--deep">
                      {child.children.map((g) => (
                        <li>
                          <ProjectRow stream={g} entries={getSubtreeEntries(g.slug)}
                                      days={dailyForSubtree(g)} span={span} scale={scale} count={g.totalCount} kid />
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="feed">
    <h2 class="eyebrow">Latest</h2>

    {/* Radio, not checkbox: these are views of one feed, not additive facets,
        and a single-select filter is what pure-CSS isolation can express
        honestly. Each project's own mark where it has one. */}
    <div class="gf" role="group" aria-label="Filter by project">
      <input type="radio" name="grp" id="g-all" checked />
      <label for="g-all"><span class="dot" aria-hidden="true"></span>All<em>{totals.entries}</em></label>
      {GROUPS.map((g) => (
        <>
          <input type="radio" name="grp" id={`g-${g.id}`} />
          <label for={`g-${g.id}`}>
            {g.icon
              ? <img src={g.icon} alt="" width="16" height="16" loading="lazy" />
              : <span class="dot" aria-hidden="true"></span>}
            {g.title}<em>{counts[g.id]}</em>
          </label>
        </>
      ))}
    </div>

    <div class="rows">
      {feed.map((entry, i) => (
        <div data-group={groupOf(entry.streamSlug)} data-extra={i >= SHOWN ? "" : undefined}>
          <EntryRow entry={entry} showOrigin accent={colorFor(span, entry.date)} />
        </div>
      ))}
    </div>

    <p class="more">
      Showing {Math.min(SHOWN, feed.length)} of {totals.entries} — filter to see
      more from one project. Every entry lives on its project's page.
    </p>
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  /* No max-width on the hero itself — the display h1 wants the narrow
     measure, the thesis under it does not. Each sets its own. */
  .hero { padding-block: 2rem 1.75rem; position: relative; }
  /* The share row floats to the top-right, level with the eyebrow. Absolute
     rather than a flex sibling so it never competes with the display type for
     horizontal space — the h1 is the only thing that gets to set that. */
  .hero > :global(.share) { position: absolute; top: 2rem; right: 0; }
  @media (max-width: 720px) {
    /* No room to float beside a clamped display headline; sit it under the
       thesis instead of letting it overlap. */
    .hero > :global(.share) { position: static; margin-top: 1.1rem; }
  }
  .hero h1 {
    max-width: 46ch;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.03em;
    margin: 0.7rem 0 1rem;
  }
  /* The one italic in the design. Bodoni's italic is the most characterful
     thing either typeface does — spend it on the verb, once. */
  .hero h1 em {
    font-style: italic;
    font-weight: 400;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .thesis {
    margin: 0;
    /* Twice the display measure. This is a stat line, not body prose — the
       short measure that suits a didone headline just made it wrap early. */
    max-width: 92ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .thesis code {
    font-size: 0.86em;
    color: var(--color-text);
    background: var(--color-surface-alt);
    padding: 0.08em 0.32em;
    border-radius: 4px;
  }

  /* ── signature strip: full-bleed out of the shell ── */
  .strip {
    margin: 0 calc(50% - 50vw) 3.5rem;
    padding: 0 max(1.25rem, calc(50vw - var(--shell) / 2));
    border-block: 1px solid var(--color-border);
    padding-block: 1.1rem 0.5rem;
    background: var(--color-surface-alt);
  }

  /* Legend states what the two series ARE. The strip is unlabelled otherwise,
     so this is the only place the reader learns area = commits. */
  .legend {
    display: flex; flex-wrap: wrap; gap: 0 2.25rem;
    margin: 0.9rem 0 0; padding: 0;
    font-family: var(--font-mono);
  }
  .legend div { display: flex; align-items: baseline; gap: 0.5rem; }
  .legend dt { font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint); }
  .legend dd { margin: 0; font-size: var(--text-sm); color: var(--color-text); font-variant-numeric: tabular-nums; }
  .legend dd small { margin-left: 0.25rem; font-size: var(--text-xs); color: var(--color-text-faint); }

  .lines { margin-top: 1.1rem; }
  .caveat {
    margin: 0.6rem 0 0;
    max-width: 124ch;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--color-text-faint);
  }

  /* ── project ledger ── */
  h2.eyebrow { margin: 0 0 0.6rem; }
  .fleet { margin-bottom: 3.25rem; }
  /* Mirrors ProjectRow's grid so each label sits over its own column. */
  .ledger-head {
    display: grid;
    grid-template-columns: minmax(11rem, 17rem) 1fr 4.5rem;
    gap: 1rem;
    align-items: end;
    padding: 0 0 0.4rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .ledger-head .cnt { text-align: right; line-height: 1.15; }
  @media (max-width: 640px) {
    .ledger-head { grid-template-columns: 1fr 4rem; }
    .ledger-head .mid { display: none; }
  }
  .ledger-rows, .kids { list-style: none; margin: 0; padding: 0; }


  /* Indentation encodes tree depth — the only thing carrying hierarchy here,
     so it needs to be unmistakable rather than decorative. */
  .kids { margin-left: 1.1rem; border-left: 1px solid var(--color-border); }
  .kids--deep { margin-left: 0.9rem; }

  /* ── feed ── */
  /* ── group filter ── */
  .gf { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.15rem; }
  .gf input { position: absolute; opacity: 0; pointer-events: none; }
  .gf label {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.32rem 0.7rem 0.32rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--color-text-faint);
    cursor: pointer; user-select: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .gf label:hover { color: var(--color-text); border-color: var(--color-text-faint); }
  .gf input:checked + label {
    color: var(--color-text);
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .gf input:focus-visible + label { outline: 1px solid var(--color-primary); outline-offset: 2px; }

  /* The counts hang back so the project name reads first. */
  .gf label em {
    font-style: normal;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }
  .gf input:checked + label em { color: var(--color-text-muted); }

  /* No plate behind the marks. Every one of them is already designed for a
     dark ground — ai-labs and content-farm carry their own background rect,
     astro-knots is transparent line-art in indigo and chartreuse — so the
     white swatch that used to sit behind them was the only thing making them
     look broken. */
  .gf label img { display: block; flex: none; }
  /* A stand-in for the groups with no mark, so every chip has the same
     left-hand rhythm. */
  .dot {
    width: 16px; height: 16px; flex: none;
    border-radius: 50%;
    border: 1px dashed var(--color-border);
  }
  .gf input:checked + label .dot { border-style: solid; border-color: var(--color-primary); }

  @media (prefers-reduced-motion: reduce) { .gf label { transition: none; } }

  /* Deep rows stay hidden until a filter narrows the feed. */
  .rows > [data-extra] { display: none; }
  .feed:has(.gf input:not(#g-all):checked) .rows > [data-extra] { display: block; }

  .feed:has(#g-ai-labs:checked) .rows > :not([data-group="ai-labs"]),
  .feed:has(#g-astro-knots:checked) .rows > :not([data-group="astro-knots"]),
  .feed:has(#g-content-farm:checked) .rows > :not([data-group="content-farm"]),
  .feed:has(#g-misc:checked) .rows > :not([data-group="misc"]) { display: none; }

  .more {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

</style>
