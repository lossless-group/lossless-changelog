---
// Self-hosted variable fonts. The old site declared Poppins/Krub and fetched
// neither, so there is no prior typography to preserve — this is a fresh choice.
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/figtree";
import "@fontsource-variable/jetbrains-mono";
import "../styles/theme.css";
import { totals } from "../lib/streams";
import MetaTags from "../components/MetaTags.astro";
import type { ShareImage } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Per-page share card. Shapes come from lib/seo.ts SHARE_IMAGES. */
  ogImage?: ShareImage;
}
const { title, description, noindex = false, ogImage } = Astro.props;
---
<!doctype html>
<html lang="en" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetaTags title={title} description={description} noindex={noindex} ogImage={ogImage} />
  </head>
  <body>
    <header class="site-head">
      <div class="shell head-inner">
        <a href="/" class="wordmark">Lossless <span class="gradient-text">Changelog</span></a>
        <nav class="head-nav">
          {/* This site's own ship log, distinct from the aggregate at `/`. */}
          <a href="/changelog/">Changelog</a>
          <span class="tally">{totals.entries} entries · {totals.streams} streams</span>
        </nav>
      </div>
    </header>

    <main class="shell"><slot /></main>

    <footer class="site-foot">
      <div class="shell">
        <p>
          Aggregated from <strong>{totals.streams}</strong> changelog streams across the
          Lossless tree via the GitHub API. Entries are mirrored from their source
          repositories — edit at the source, not here.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-head {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .head-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    font-size: 1.15rem;
  }
  .wordmark span { font-style: italic; }
  .wordmark:hover { text-decoration: none; }
  .head-nav { display: flex; align-items: baseline; gap: 1rem; }
  .head-nav > a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .head-nav > a:hover { color: var(--color-primary); text-decoration: none; }
  .tally { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-faint); font-variant-numeric: tabular-nums; }

  main { padding-block: 2.25rem 4rem; }

  .site-foot {
    border-top: 1px solid var(--color-border);
    padding-block: 1.5rem;
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }
  .site-foot p { max-width: var(--measure); margin: 0; }

  @media (max-width: 640px) {
    .head-inner { flex-direction: column; align-items: flex-start; gap: 0.2rem; }
  }
</style>
