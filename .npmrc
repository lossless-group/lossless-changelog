# Treat this project as standalone — do not discover or use the parent
# astro-knots workspace. Critical for Vercel: without this, pnpm errors out
# looking for pnpm-workspace.yaml. The site stays standalone in both
# lfm:local and lfm:jsr modes — local mode uses a relative `link:` path to
# /Users/mpstaton/code/lossless-monorepo/lfm rather than workspace resolution.
ignore-workspace=true

# JSR registry — required to resolve @jsr/* aliased deps like
# @lossless-group/lfm (published at jsr.io/@lossless-group/lfm and consumed
# via the npm alias `npm:@jsr/lossless-group__lfm@latest` in package.json).
# Public registry, no auth token needed — works the same in dev and on Vercel.
@jsr:registry=https://npm.jsr.io

# Hoist into a flat node_modules so plugins expecting a classic layout work.
shamefully-hoist=true

# Auto-install peer deps, and don't fail the build on peer mismatches.
auto-install-peers=true
strict-peer-dependencies=false
